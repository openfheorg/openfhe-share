#default env var files (will be copied to .env.local at run start)

# Source settings
# The local source trees at ../backend and ../frontend are used directly.

# change to "host" if you want to run mysql on the host
# "container" will skip host install and use the docker-compose mysql service
DUALITY_DB_MODE=container

# IMPORTANT:
# Do not set the application user to root when using DUALITY_DB_MODE=container (container won't start)
# If you're using DUALITY_DB_MODE=host then these connection settings needed to connect to your local
# mysql install. These default settings are for running as DUALITY_DB_MODE=container:
DUALITY_MYSQL_HOST=localhost
DUALITY_MYSQL_PORT=3307
DUALITY_MYSQL_USER=duality
DUALITY_MYSQL_PASSWORD=duality_pass
DUALITY_MYSQL_DB=duality_local

# Root password for the MySQL container (used by the image to initialize root)
# If omitted, docker-compose defaults to "rootpass" from mysql.Dockerfile.
# You can override it here if desired.
MYSQL_ROOT_PASSWORD=rootpass

# NVFLARE local runtime
DUALITY_NVFLARE_HOST=auto
DUALITY_NVFLARE_FED_PORT=8002
DUALITY_NVFLARE_ADMIN_PORT=8003
DUALITY_NVFLARE_PROJECT_FILE=project.yml
DUALITY_NVFLARE_WORKSPACE=./nvflare_workspace
DUALITY_NVFLARE_ADMIN_NAME=admin@share.local
DUALITY_NVFLARE_JOB_SAVE_LOCATION=./job-results

# Toggle to true if you'd like mysql to rebuild from scratch then run 'python main.py rebuild mysql backend' 
# to reset the database and restart the backend (so login rebuilds database)
DUALITY_DB_WIPE_ON_REBUILD=false

# Data sources (how the source configs are built)
DUALITY_CLIENT_SITE3_DATASOURCE_1=nvflare_stage/data/Survivability_FHIR_Data_part1.json
DUALITY_CLIENT_SITE1_DATASOURCE_1=nvflare_stage/data/Survivability_FHIR_Data_part2.json
DUALITY_CLIENT_SITE2_DATASOURCE_1=nvflare_stage/data/Survivability_FHIR_Data_part3.json

# Biomarker: project 2 MSKChord datasource group
# DATASOURCE_<project_id>_<datasource_group_id>
#   2_1 = MSKChord
#
# Site 3 is the training cohort; sites 1 and 2 are validation cohorts.
DUALITY_CLIENT_SITE3_DATASOURCE_2_1=nvflare_stage/data/Biomarker_MSKChord_FHIR_Data_training_bundle.json
DUALITY_CLIENT_SITE1_DATASOURCE_2_1=nvflare_stage/data/Biomarker_MSKChord_FHIR_Data_testing_bundle_site1.json
DUALITY_CLIENT_SITE2_DATASOURCE_2_1=nvflare_stage/data/Biomarker_MSKChord_FHIR_Data_testing_bundle_site2.json
