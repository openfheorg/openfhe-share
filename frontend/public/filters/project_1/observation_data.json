{
  "version": "2.0",
  "resource": {
    "type": "Observation"
  },
  "localPass": {
    "observationModel": {
      "variantAssessmentCode": {
        "extractor": "component_or_text_code",
        "args": {
          "componentCodeSystem": "",
          "componentCode": "",
          "valueMap": {
            "69548-6": [
              "69548-6"
            ]
          },
          "idFallback": {}
        }
      },
      "positive": {
        "extractor": "interpretation_positive"
      },
      "changeType": {
        "extractor": "component_or_text_code",
        "args": {
          "componentCodeSystem": "http://loinc.org",
          "componentCode": "48019-4",
          "valueMap": {
            "deletion": [
              "deletion",
              "so:0000159"
            ],
            "duplication": [
              "duplication",
              "so:1000035"
            ],
            "amplification": [
              "amplification",
              "copy_number_gain",
              "so:0001742",
              "so:0001869"
            ]
          },
          "idFallback": {
            "deletion": [
              "-deletion-",
              "-del-"
            ],
            "duplication": [
              "-duplication-",
              "-dup-"
            ],
            "amplification": [
              "-amplification-",
              "-amp-"
            ]
          }
        }
      },
      "region": {
        "extractor": "component_or_id_region",
        "args": {
          "componentCodeSystem": "http://loinc.org",
          "componentCode": "48013-7",
          "idRegex": "(?:deletion|amplification|duplication)-(.+)$"
        }
      }
    },
    "patientMetrics": {
      "deletions": {
        "aggregate": "count",
        "where": {
          "variantAssessmentCode": "69548-6",
          "positive": true,
          "changeType": "deletion"
        }
      },
      "amplifications": {
        "aggregate": "count",
        "where": {
          "variantAssessmentCode": "69548-6",
          "positive": true,
          "changeType": "amplification"
        }
      },
      "duplications": {
        "aggregate": "count",
        "where": {
          "variantAssessmentCode": "69548-6",
          "positive": true,
          "changeType": "duplication"
        }
      },
      "total": {
        "aggregate": "sumMetrics",
        "metrics": [
          "deletions",
          "amplifications",
          "duplications"
        ]
      },
      "deletionRegionSet": {
        "aggregate": "set",
        "where": {
          "variantAssessmentCode": "69548-6",
          "positive": true,
          "changeType": "deletion"
        },
        "value": "region"
      },
      "amplificationRegionSet": {
        "aggregate": "set",
        "where": {
          "variantAssessmentCode": "69548-6",
          "positive": true,
          "changeType": "amplification"
        },
        "value": "region"
      },
      "variantAssessmentCodes": {
        "aggregate": "set",
        "where": {},
        "value": "variantAssessmentCode"
      }
    }
  },
